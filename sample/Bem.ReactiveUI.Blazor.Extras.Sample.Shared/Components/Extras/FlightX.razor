@inherits ComponentBaseX<Bem.ReactiveUI.Blazor.Extras.Sample.ViewModels.FlightViewModel>
<Container Class="flash">
@RenderCountFragment
<Row>
    <Column ColumnSize="ColumnSize.IsHalf">
        <TextInput Plaintext ReadOnly>Airline</TextInput>
        <TextInput Plaintext ReadOnly>@(ViewModel?.Airline)</TextInput>
    </Column>
    <Column ColumnSize="ColumnSize.IsHalf">
        <TextInput Plaintext ReadOnly>Plane Type</TextInput>
        <TextInput Plaintext ReadOnly>@(ViewModel?.PlaneType)</TextInput>
    </Column>
</Row>
</Container>